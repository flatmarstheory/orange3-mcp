FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

ENV ORANGE3_MCP_DATA_DIR=/data
RUN mkdir -p /data

LABEL io.docker.server.metadata="{name: orange3-mcp, type: server, title: Orange3 MCP, description: Build inspect and save Orange3 data-mining workflows through MCP}"

CMD ["orange3-mcp"]